{
  "name": "score-table",
  "version": "0.1.0",
  "description": "A score table for the SuperInstance fleet: rows that declare their denominator, their pre-registered tolerance, and their receipt. PASS, FAIL, and NOT_MEASURED.",
  "type": "module",
  "main": "./src/score.mjs",
  "exports": {
    ".": "./src/score.mjs",
    "./schema": "./src/schema.mjs",
    "./pre-registration": "./src/pre-registration.mjs"
  },
  "bin": {
    "score-table": "./bin/score-table.mjs"
  },
  "files": [
    "src",
    "bin",
    "data",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node test/all.mjs",
    "table": "node bin/score-table.mjs --quorum",
    "test:raw": "node --test \"test/*.test.mjs\""
  },
  "keywords": [
    "score-table",
    "conformance",
    "denominator",
    "quorum",
    "quilt"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SuperInstance/score-table.git"
  },
  "private": false
}
